#pragma once

/*
 * 本地密钥模板 —— 复制成 main/secrets.h 后填入你自己的值。
 * main/secrets.h 已被 .gitignore 忽略，不会提交到仓库。
 * 首次开机时 app_settings 会把这些值写进 NVS，之后以 NVS 为准。
 */

/* ---- WiFi（留空 = 开机进入配网热点）---- */
#define APP_SECRET_WIFI_SSID      "your-wifi-ssid"
#define APP_SECRET_WIFI_PASSWORD  "your-wifi-password"

/* ---- Home Assistant（不要带结尾斜杠）---- */
#define APP_SECRET_HA_URL         "https://ha.example.com"

/* 长期访问令牌：HA → 左下角用户名 → 安全 → 长期访问令牌 */
#define APP_SECRET_HA_TOKEN       "eyJ...your-long-lived-token"

/* ---- switchyard MQTT（留空 = 不启用 MQTT）---- */
#define APP_SECRET_MQTT_HOST      "mqtt.example.com"
#define APP_SECRET_MQTT_PORT      1883
#define APP_SECRET_MQTT_USER      "mqtt-user"
#define APP_SECRET_MQTT_PASS      "mqtt-password"

/* ---- 设备身份：出现在 switchyard/<device_id>/... 主题里 ---- */
#define APP_SECRET_DEVICE_NAME    "圆屏"
#define APP_SECRET_DEVICE_ID      ""   /* 留空 = 自动生成 orbis-xxxx（MAC 后 4 位）*/

/* ---- 设置页 http://<设备IP>/ 的 HTTP Basic Auth ---- */
#define APP_SECRET_WEB_USER       "admin"
#define APP_SECRET_WEB_PASS       "admin"
