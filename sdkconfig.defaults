CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_OS_NONE=y
# LVGL heap uses main/lv_mem_psram.c (PSRAM custom allocator); with a custom
# allocator there is no static LV_MEM_SIZE pool in .bss any more.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_LV_DEF_REFR_PERIOD=16

# ---- Bluetooth: Classic BT (BR/EDR) + Bluedroid + A2DP source ----
# Same block as IDF examples/bluetooth/bluedroid/classic_bt/a2dp_source/sdkconfig.defaults.
# Classic BT only (A2DP source feeds TTS audio to a BT speaker), BLE is not built.
# The stack is NOT started at boot: bt_link.c brings up
# esp_bt_controller_init/enable + bluedroid on demand and tears it down after
# 60 s idle (see the lifecycle comment at the top of bt_link.c).
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_BLE_ENABLED=n
# About CONFIG_BT_DRAM_RELEASE: the classic-BT examples say it must stay off for
# classic BT. IDF 6.1 (this project) no longer defines that Kconfig symbol at all
# (it only survives as a comment in the old example sdkconfig files), so there is
# nothing to set here: it is permanently off and cannot be switched on by accident.
CONFIG_BT_ENABLED=y
# BT memory optimisation: allocate from PSRAM first, single ACL link, no BT logs, small task stacks
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BT_STACK_NO_LOG=y
CONFIG_BT_BTC_TASK_STACK_SIZE=3072
CONFIG_BT_BTU_TASK_STACK_SIZE=3584
# TLS memory: smaller record buffers + mbedTLS state in PSRAM
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
